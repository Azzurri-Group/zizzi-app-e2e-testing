{
  "compilerOptions": {
    "rootDir": "src",
    "lib": [
      "es2021",
      "dom"
    ],
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "es2021",
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "jest"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./src/e2e/support"
    ]
  },
  "include": [
    "src",
    "src/e2e/support/global.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
