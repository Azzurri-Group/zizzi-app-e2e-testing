{
  "testRunner": {
    "args": {
      "config": "jest.config.js"
    },
    "nodeModulesBinDir": "node_modules/.bin",
    "type": "jest"
  },
  "apps": {
    "zizziApp.ios": {
      "type": "ios.app",
      "binaryPath": "../zizzi-loyalty-app/ios/build/ZizziLoyaltyApp/Build/Products/Debug-iphonesimulator/ZizziLoyaltyApp.app",
      "build": "cd ../zizzi-loyalty-app && npx expo run:ios --no-install"
    }
  },
  "devices": {
    "simulator": {
      "type": "ios.simulator",
      "device": {
        "type": "iPhone 14"
      }
    }
  },
  "configurations": {
    "ios.sim.debug": {
      "device": "simulator",
      "app": "zizziApp.ios"
    }
  }
}