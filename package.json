{
  "name": "microservice-template",
  "version": "1.0.0",
  "private": true,
  "description": "A Koa-based microservice template",
  "engines": {
    "node": "16.x.x"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "npm run build && node -r dotenv/config dist/server.js",
    "start:dev": "NODE_ENV=localhost nodemon -r dotenv/config --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch --changedSince=main",
    "test:coverage": "jest --coverage",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azzurri-Group/microservice-template.git"
  },
  "dependencies": {
    "@azzurri-group/logger": "^1.0.11",
    "@koa/cors": "^3.1.0",
    "@koa/router": "^10.1.1",
    "config": "^3.3.6",
    "dotenv": "^10.0.0",
    "koa": "^2.13.4",
    "koa-helmet": "^6.1.0"
  },
  "devDependencies": {
    "@azzurri-group/eslint-config-pat-recommended": "^3.0.3",
    "@types/config": "^0.0.40",
    "@types/jest": "^27.0.2",
    "@types/koa": "^2.13.4",
    "@types/koa__cors": "^3.0.3",
    "@types/koa__router": "^8.0.9",
    "@types/node": "^16.11.6",
    "@types/prettier": "^2.4.1",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.3.0",
    "@typescript-eslint/parser": "^5.3.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-typescript": "^15.0.0",
    "eslint-plugin-jest": "^25.2.3",
    "husky": "^7.0.4",
    "jest": "^27.3.1",
    "lint-staged": "^11.2.6",
    "nodemon": "^2.0.14",
    "prettier": "^2.4.1",
    "supertest": "^6.1.6",
    "ts-jest": "^27.0.7",
    "ts-node": "^10.4.0",
    "typescript": "^4.4.4"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  }
}
