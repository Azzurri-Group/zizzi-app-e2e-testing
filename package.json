{
  "name": "zizzi-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "E2E testing setup for Zizzi booking app using Detox and Playwright",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "jest",
    "test:detox": "detox test --configuration ios.sim.debug",
    "build:ios": "expo run:ios --no-install",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "expo": "^53.0.19",
    "expo-dev-client": "~5.2.4",
    "react": "19.0.0",
    "react-native": "0.79.5"
  },
  "devDependencies": {
    "@types/detox": "^17.14.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.1.0",
    "@types/react": "~19.0.10",
    "detox": "18.23.2-next.0",
    "jest": "^28.1.3",
    "jest-circus": "^29.7.0",
    "jest-cli": "^28.1.3",
    "jest-expo": "^53.0.9",
    "playwright": "1.45.0",
    "ts-jest": "^28.0.8",
    "ts-node": "^10.4.0",
    "typescript": "^5.2.0"
  }
}
